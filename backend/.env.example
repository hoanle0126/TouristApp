DATABASE_URL="postgresql://postgres:postgres@localhost:5432/touristweb?schema=public"

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
MAIL_FROM="your-from-email@example.com"
ADMIN_EMAIL="your-admin-email@example.com"

SETTINGS_ENCRYPTION_KEY="your-32-byte-base64-key"

# Generate SETTINGS_ENCRYPTION_KEY with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
