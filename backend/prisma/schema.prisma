generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tour {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  badge            String?
  type             String
  duration         String
  guests           String
  price            String
  availability     String
  description      Json
  shortDescription String
  image            String
  heroImage        String
  subtitle         String
  highlights       Json
  itinerary        Json
  gallery          Json
  inclusions       Json
  exclusions       Json
  destinationId    String
  destination      Destination     @relation(fields: [destinationId], references: [id])
  hotels           Hotel[]
  departures       TourDeparture[]
  mentionedInPosts BlogPost[]      @relation("BlogMentionedTours")
  bookingItems     BookingItem[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([destinationId])
}

model TourDeparture {
  id           String        @id @default(cuid())
  tourId       String
  tour         Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  date         DateTime      @db.Date
  capacity     Int
  booked       Int           @default(0)
  status       String        @default("open")
  bookingItems BookingItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tourId, date])
  @@index([date])
  @@index([status])
}

model Destination {
  id               String     @id @default(cuid())
  slug             String     @unique
  title            String
  description      String
  image            String
  heroImage        String
  summary          String
  intro            Json
  facts            Json
  spotlight        Json
  tours            Tour[]
  hotels           Hotel[]
  mentionedInPosts BlogPost[] @relation("BlogMentionedDestinations")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  badge       String
  date        String
  location    String
  description String
  href        String
  image       String
  alt         String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model TravelerReview {
  id        String   @id @default(cuid())
  name      String
  role      String
  trip      String
  quote     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Hotel {
  id               String              @id @default(cuid())
  slug             String              @unique
  name             String
  location         String
  address          String
  price            String
  badge            String?
  status           String              @default("published")
  listingImage     String
  heroImage        String
  description      Json
  amenities        Json
  suites           Json
  gallery          Json
  booking          Json
  destinations     Destination[]
  tours            Tour[]
  inventoryDays    HotelInventoryDay[]
  mentionedInPosts BlogPost[]          @relation("BlogMentionedHotels")
  bookingItems     BookingItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([location])
  @@index([status])
}

model HotelInventoryDay {
  id          String   @id @default(cuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  totalRooms  Int
  bookedRooms Int      @default(0)
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([hotelId, date])
  @@index([date])
  @@index([status])
}

model BlogPost {
  id                    String        @id @default(cuid())
  slug                  String        @unique
  title                 String
  excerpt               String
  category              String
  author                String
  status                String        @default("published")
  publishedAt           DateTime
  readingTime           String
  image                 String
  heroImage             String
  intro                 String
  meta                  String
  quote                 String
  sections              Json
  inlineImage           Json
  secondaryFeature      Json
  relatedPosts          Json
  seo                   Json
  mentionedDestinations Destination[] @relation("BlogMentionedDestinations")
  mentionedTours        Tour[]        @relation("BlogMentionedTours")
  mentionedHotels       Hotel[]       @relation("BlogMentionedHotels")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([category])
  @@index([status])
  @@index([publishedAt])
}

model Booking {
  id                   String        @id @default(cuid())
  bookingCode          String        @unique
  fullName             String
  email                String
  phone                String
  country              String
  city                 String?
  address              String?
  travelers            Int
  primaryTravelerName  String?
  primaryTravelerEmail String?
  primaryTravelerPhone String?
  travelerDetails      Json?
  startDate            DateTime?
  endDate              DateTime?
  pickupLocation       String?
  dropoffLocation      String?
  arrivalFlight        String?
  specialRequests      String?
  internalNotes        String?
  aiSummary            String?
  bankTransfer         Json?
  paymentMethod        String
  paymentStatus        String        @default("pending")
  status               String        @default("pending")
  subtotal             Decimal       @db.Decimal(10, 2)
  taxesAndFees         Decimal       @default(0) @db.Decimal(10, 2)
  total                Decimal       @db.Decimal(10, 2)
  currency             String        @default("USD")
  items                BookingItem[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([email])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model BookingItem {
  id                 String         @id @default(cuid())
  bookingId          String
  booking            Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  itemType           String
  tourId             String?
  tour               Tour?          @relation(fields: [tourId], references: [id], onDelete: SetNull)
  tourDepartureId    String?
  tourDeparture      TourDeparture? @relation(fields: [tourDepartureId], references: [id], onDelete: SetNull)
  hotelId            String?
  hotel              Hotel?         @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  snapshotSlug       String
  snapshotTitle      String
  snapshotImage      String?
  snapshotAlt        String?
  snapshotMeta       String?
  snapshotPriceLabel String?
  date               String?
  checkIn            DateTime?
  checkOut           DateTime?
  guests             String?
  nights             Int?
  roomType           String?
  quantity           Int
  unitPrice          Decimal        @db.Decimal(10, 2)
  lineTotal          Decimal        @db.Decimal(10, 2)
  currency           String         @default("USD")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([bookingId])
  @@index([tourId])
  @@index([tourDepartureId])
  @@index([hotelId])
  @@index([itemType])
}

model AiProviderConfig {
  id              String   @id
  provider        String
  baseUrl         String
  model           String
  encryptedApiKey String?
  apiKeyLast4     String?
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ShopPaymentConfig {
  id            String   @id
  bankBin       String
  bankName      String
  accountNumber String
  accountName   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteContentConfig {
  id              String   @id
  siteName        String
  siteTagline     String
  siteDescription String
  contactEmail    String
  hotline         String
  topBarNote      String
  promoLabel      String
  promoCta        String
  promoHref       String
  homeHeroImage   String
  heroImageTwo    String
  heroImageThree  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
